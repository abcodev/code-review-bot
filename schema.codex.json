{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "posted": {"type": "boolean", "description": "리뷰를 끝까지 수행했으면 true(지적 0건 포함). 상태 변경 등으로 중단하면 false"},
    "rereview": {"type": "boolean"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "red": {"type": "integer"},
        "yellow": {"type": "integer"},
        "green": {"type": "integer"},
        "question": {"type": "integer"}
      },
      "required": ["red", "yellow", "green", "question"]
    },
    "prior": {
      "type": "object",
      "additionalProperties": false,
      "description": "재리뷰일 때 이전 지적 수와 반영 여부. 처음 리뷰면 전부 0",
      "properties": {
        "total": {"type": "integer"},
        "resolved": {"type": "integer"},
        "unresolved": {"type": "integer"}
      },
      "required": ["total", "resolved", "unresolved"]
    },
    "headline": {"type": "string", "description": "슬랙 답글용 한 줄 요약, 60자 이내 존댓말"},
    "skipped_reason": {"type": "string", "description": "게시하지 않았을 때만 사유, 아니면 빈 문자열"}
  },
  "required": ["posted", "rereview", "counts", "prior", "headline", "skipped_reason"]
}
